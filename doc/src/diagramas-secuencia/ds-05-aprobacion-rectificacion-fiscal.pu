@startuml DS05_Aprobacion_Rectificacion_Fiscal
    autonumber
    skinparam sequenceMessageAlign center
    skinparam responseMessageBelowArrow true

    title DS-05: Aprobación de Excepciones y Rectificación Fiscal (UC-16 / UC-15 / UC-10)

    actor "Administrador" as Admin
    participant "UI : Frontend SPA" as UI
    participant "API : ControladorAprobaciones" as API
    participant "usuario : Usuario" as User
    participant "solicitud : SolicitudAprobacion" as Sol
    participant "facturaOrig : Factura" as FacOrig
    participant "factory : FacturaRectificativaFactory" as Factory
    participant "facturaRect : Factura" as FacRect
    participant "eventos : GestorEventosDominio" as Eventos
    participant "auditoriaObs : AuditoriaObserver" as AudObs
    participant "notifObs : NotificacionObserver" as NotifObs

    Admin -> UI : Revisa solicitud en bandeja y confirma aprobación
    activate UI

    UI -> API : POST /api/aprobaciones/{solicitudId}/aprobar
    activate API

    API -> User : tienePermiso("RESOLVER_APROBACION")
    activate User
    User --> API : autorizado : Boolean
    deactivate User

    alt Permisos insuficientes (!autorizado)
        API --> UI : 403 Forbidden (Acceso denegado)
        deactivate API
        UI --> Admin : Muestra error de permisos
        deactivate UI
    else Usuario autorizado
        API -> FacOrig : esTrimestreCerrado()
        activate FacOrig
        FacOrig --> API : trimestreCerrado : Boolean
        deactivate FacOrig

        alt Trimestre cerrado sin excepción de Superadministrador (RB-08)
            API --> UI : 409 Conflict (Periodo cerrado: edición ordinaria bloqueada)
            deactivate API
            UI --> Admin : Informa bloqueo por cierre trimestral
            deactivate UI
        else Operación permitida
            API -> Sol : aprobar(usuario)
            activate Sol
            Sol -> Sol : estado = "APROBADA", fechaResolucion = now()
            Sol --> API : ok
            deactivate Sol

            opt Solicitud corresponde a rectificación de factura emitida (UC-15 / RB-06)
                API -> Factory : crearFactura(facturaOrig.cliente)
                activate Factory
                create FacRect
                Factory -> FacRect : <<create>>(tipo="RECTIFICATIVA", facturaOriginalId=facturaOrig.id)
                activate FacRect
                FacRect -> FacRect : recalcularTotales()
                FacRect --> Factory : facturaRect
                deactivate FacRect
                Factory --> API : facturaRect
                deactivate Factory
            end

            API -> Eventos : publicarEvento("SOLICITUD_APROBADA_Y_APLICADA", payload)
            activate Eventos
            Eventos -> AudObs : actualizar("SOLICITUD_APROBADA_Y_APLICADA", payload)
            activate AudObs
            note right of AudObs: Inserta registro inmutable en AuditoriaLog\n(valoresAnteriores, valoresNuevos, aprobadorId)
            AudObs --> Eventos : trazaInmutableGuardada
            deactivate AudObs

            Eventos -> NotifObs : actualizar("SOLICITUD_APROBADA_Y_APLICADA", payload)
            activate NotifObs
            NotifObs --> Eventos : notificacionSolicitanteCreada
            deactivate NotifObs

            Eventos --> API : void
            deactivate Eventos

            API --> UI : 200 OK (Cambio aprobado y auditado)
            deactivate API
            UI --> Admin : Confirma resolución exitosa
            deactivate UI
        end
    end
@enduml