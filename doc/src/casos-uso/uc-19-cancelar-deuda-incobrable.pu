@startuml uc-19
left to right direction

actor "Administrador" as Admin

rectangle "uc-19 Cancelar deuda incobrable" {
  usecase "Cancelar deuda" as UC19
  usecase "Indicar motivo de cancelación" as Motivo
  usecase "gestionar aprobaciones" as UC16
}

Admin -- UC19

UC19 ..> Motivo : <<include>>
Motivo ..> UC16 : <<include>>

note right of UC19
  <b>Precondición: 
  Existe una factura
  vencida y sin cobrar.
end note
@enduml