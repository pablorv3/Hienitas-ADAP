@startuml uc-03
    left to right direction
    skinparam packageStyle rectangle

    actor "Administrador" as Admin

    rectangle "UC-03: Gestionar asignación de clientes" {
        usecase "Gestionar asignación\nde clientes" as UC_Gestionar
        usecase "Asignar uno o varios clientes" as UC_Asignar
        usecase "Mostrar rango de modificación y confirmar\nla operación" as UC_Confirmar
        usecase "Desasignar cliente sin nuevo\nresponsable inmediato" as UC_Desasignar
        usecase "Delegar clientes temporalmente" as UC_Delegar

        ' La asignación, la desasignación y la delegación son operaciones de la gestión.
        UC_Gestionar <.. UC_Asignar : <<extend>>
        UC_Gestionar <.. UC_Desasignar : <<extend>>
        UC_Gestionar <.. UC_Delegar : <<extend>>

        ' En el flujo de asignación se muestra el alcance y se solicita confirmación.
        UC_Asignar ..> UC_Confirmar : <<include>>
    }

    note right of UC_Asignar
      <b>Reglas:</b>
      - Solicita confirmación antes de aplicar el cambio.
      - Al cambiar el responsable, las tareas pendientes pasan al nuevo responsable.
      - Se conserva quién realizó las acciones anteriores y los cambios quedan auditados.
    end note

    Admin -- UC_Gestionar
@enduml
