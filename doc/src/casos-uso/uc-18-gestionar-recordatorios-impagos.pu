@startuml uc-18


actor "Procesos automáticos" as PA
actor "Usuario operativo" as UO

rectangle "uc-18 Recordatorio de impagos" {
  usecase "Gestionar recordatorios\ne impagos" as UC18
  usecase "Calcular vencimiento y\nenviar recordatorios previos" as Previos
  usecase "Marcar vencida e iniciar\nflujo de impago" as Impago
  usecase "Suspender recordatorios\ntemporalmente" as Suspender
  usecase "Detener flujo por\nintervención manual" as Intervenir


  PA -- UC18
  UO -- Suspender
  UO -- Intervenir

  Previos <.. UC18 : <<include>>
  Impago <.. UC18 : <<include>>
  Suspender ..> UC18 : <<extend>>
  Intervenir ..> UC18 : <<extend>>
}

note top of UC18
  El flujo se detiene automáticamente
  al detectarse el cobro.
end note
@enduml