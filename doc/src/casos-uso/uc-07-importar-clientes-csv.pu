@startuml uc-07
    left to right direction
    skinparam packageStyle rectangle

    actor "Usuario Operativo" as UO
    actor "Administrador" as Admin

    ' Herencia de actores
    Admin -|> UO

    rectangle "UC-07: Importar clientes desde CSV" {
        usecase "Importar clientes desde CSV" as UC_Importar
        usecase "Validar filas y previsualizar" as UC_Validar
        usecase "Mapear columnas del fichero" as UC_Mapear
        usecase "Reintentar carga tras corrección" as UC_Reintentar
        usecase "Importar solo filas válidas" as UC_SoloValidas

        ' Inclusiones obligatorias
        UC_Importar ..> UC_Validar : <<include>>
        UC_Importar ..> UC_Mapear : <<include>>

        ' Flujos alternativos
        UC_Importar <.. UC_Reintentar : <<extend>>
        UC_Importar <.. UC_SoloValidas : <<extend>>
    }

    ' Asociaciones simples
    UO -- UC_Importar

@enduml
