@startuml uc-15
  left to right direction

  actor "Administrador" as Admin

  ' Caso de uso principal
  usecase "Rectificar factura" as Rectificar

  ' Casos de uso alternativos y excepciones
  usecase "Registrar cambio menor" as CambioMenor
  usecase "Procedimiento excepcional (Auditado)" as Excepcional

  ' Casos de uso externos referenciados
  usecase "Aprobar excepciones" as UC16

  ' Relaciones del Actor
  Admin --> Rectificar

  ' Flujos Alternativos y Excepciones (Extends)
  UC16 .up.> Rectificar : <<extend>>\n(Requiere aprobación por importe)
  CambioMenor .up.> Rectificar : <<extend>>\n(Correcciones menores sin rectificativa)
  Excepcional .up.> Rectificar : <<extend>>\n(El periodo está cerrado)

  ' Nota de requisitos forzada abajo
  note " **Requisitos:** \n FR-048, FR-049, FR-050, FR-060 \n\n **Internamente incluye:** \n Proponer datos originales, emitir \n nota de crédito vinculada y \n actualizar el saldo del cliente." as NotaReq
  Rectificar -down- NotaReq

@enduml