@startuml uc-17
left to right direction

actor "Sistema de pagos (externo)" as SP
actor "Usuario operativo" as UO

rectangle "uc-17 Conciliar cobros" {
  usecase "Conciliar cobros" as UC17
  usecase "Conciliación automática" as Auto
  usecase "Conciliación manual\n(anomalia)" as Manual
  usecase "Revisar diferencia de importe" as RevDiff
  usecase "Revertir conciliación" as Revert


  SP -- Auto
  UO -- UC17 

  Auto <.. UC17 : <<include>>
  Manual ..> UC17 : <<extend>>
  RevDiff ..> UC17 : <<extend>>
  Revert ..> UC17 : <<extend>>
}
@enduml