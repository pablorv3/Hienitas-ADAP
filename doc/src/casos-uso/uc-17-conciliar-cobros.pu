@startuml uc-17
left to right direction
skinparam packageStyle rectangle

actor "Sistema de pagos\n(Externo)" as SP
actor "Usuario operativo" as UO

package "Sistema de Facturación" {
  usecase "UC-17 Conciliar cobros" as UC17
  usecase "Conciliación automática" as Auto
  usecase "Conciliación manual\n(Referencia no clara)" as Manual
  usecase "Revisar diferencia de importe" as RevDiff
  usecase "Revertir conciliación" as Revert
}

SP --> UC17 : Notifica cobro
UO --> UC17 : Consulta / Supervisa
UO --> Manual
UO --> RevDiff
UO --> Revert

Auto .up.> UC17 : <<include>>
Manual .up.> UC17 : <<extend>>
RevDiff .up.> UC17 : <<extend>>
Revert .up.> UC17 : <<extend>>
@enduml