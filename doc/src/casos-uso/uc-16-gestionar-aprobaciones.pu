@startuml uc-16
left to right direction

actor "Usuario operativo" as UO
actor "Administrador" as Admin

rectangle "uc-16: Gestionar Aprobacion" {
  usecase "Gestionar aprobaciones" as UC16
  usecase "Solicitar aprobación de\noperación sensible" as Solicitar
  usecase "Aprobar / Rechazar solicitud" as Resolver
  usecase "Añadir Comentario" as Comentario
}

UO -- Solicitar
Admin -- Resolver

Solicitar ..> UC16 : <<include>>
Resolver ..> UC16 : <<include>>
Resolver <.. Comentario : <<extend>>
@enduml