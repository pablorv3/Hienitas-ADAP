@startuml uc-21
    left to right direction
    skinparam packageStyle rectangle

    actor "Usuario Operativo" as UO
    actor "Administrador" as Admin

    ' El Administrador hereda todos los permisos del Usuario Operativo
    Admin -|> UO

    rectangle "UC-21: Gestionar comentarios y adjuntos" {
        usecase "Añadir comentario a factura/incidencia" as UC_Comentar
        usecase "Mencionar a un compañero" as UC_Mencionar
        usecase "Restringir visibilidad a administradores" as UC_Restringir
        
        usecase "Subir documento adjunto" as UC_Subir
        usecase "Descargar adjunto" as UC_Descargar

        ' Flujos alternativos/opcionales del comentario
        UC_Comentar <.. UC_Mencionar : <<extend>>
    
        UC_Comentar <.. UC_Restringir : <<extend>>
    
    }
    ' Conexiones principales del Usuario Operativo
    UO -- UC_Comentar
    UO -- UC_Subir
    UO -- UC_Descargar

    ' El administrador interviene directamente en la restricción
    Admin -- UC_Restringir

    ' Nota de validación asociada al uso de subida de archivos
note bottom of UC_Subir
  <b>Validación obligatoria (NFR-25):</b>
  El sistema valida formato y tamaño
  máximo permitido antes de almacenar.
end note
@enduml