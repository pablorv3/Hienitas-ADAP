@startuml prueba
autonumber
actor User
boundary "Login Page" as Login
control "Auth Service" as Auth
database Database

User -> Login : Enter credentials
activate Login
Login -> Auth : Validate(user, pass)
activate Auth
Auth -> Database : Query user record
activate Database
Database --> Auth : User record found
deactivate Database

alt successful login
    Auth --> Login : Token generated
    Login --> User : Redirect to Dashboard
else invalid credentials
    Auth --> Login : Error code
    Login --> User : Show "Invalid Credentials"
    deactivate Auth
    deactivate Login
end
@endum
