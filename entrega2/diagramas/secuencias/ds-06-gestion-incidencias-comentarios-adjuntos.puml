@startuml DS06_Incidencias_Comentarios_Adjuntos
    autonumber
    skinparam sequenceMessageAlign center
    skinparam responseMessageBelowArrow true

    title DS-06: Gestión de Incidencias, Comentarios y Adjuntos (UC-20 / UC-21 / UC-22)

    actor "Usuario Operativo" as UO
    participant "UI : Frontend SPA" as UI
    participant "API : ControladorIncidencias" as API
    participant "incidencia : Incidencia" as Inc
    participant "comentario : Comentario" as Com
    participant "storage : StorageSeguro" as Storage
    participant "adjunto : Adjunto" as Adj
    participant "eventos : GestorEventosDominio" as Eventos
    participant "notifObs : NotificacionObserver" as NotifObs
    participant "notif : Notificacion" as Notif
    participant "recibe : RecibeNotificacion" as Recibe

    UO -> UI : Crea incidencia, añade comentario (@mención) y adjunta archivo
    activate UI

    UI -> API : POST /api/incidencias (multipart/form-data)
    activate API

    API -> API : validarDatosYFichero(datos, archivo)

    alt Formato MIME no permitido o tamaño excedido (NFR-25)
        API --> UI : 400 Bad Request (Fichero no válido)
        deactivate API
        UI --> UO : Muestra error de validación de archivo
        deactivate UI
    else Validación correcta
        create Inc
        API -> Inc : <<create>>(clienteId, facturaId, titulo, descripcion, estado="ABIERTA")

        create Com
        API -> Com : <<create>>(texto, restringidoAdmin, usuarioId)

        opt Incluye fichero de apoyo (UC-21)
            API -> Storage : guardarFicheroPrivado(archivo)
            activate Storage
            Storage --> API : rutaStorage : String
            deactivate Storage

            create Adj
            API -> Adj : <<create>>(nombreArchivo, rutaStorage, tipoMime)
        end

        opt Incidencia afecta al cobro y solicita pausar avisos (FR-077)
            API -> API : suspenderRecordatoriosFactura(facturaId)
        end

        API -> Eventos : publicarEvento("INCIDENCIA_Y_MENCION_CREADA", payload)
        activate Eventos
        Eventos -> NotifObs : actualizar("INCIDENCIA_Y_MENCION_CREADA", payload)
        activate NotifObs

        create Notif
        NotifObs -> Notif : <<create>>(titulo, mensaje, requiereAccion=true)

        create Recibe
        NotifObs -> Recibe : <<create>>(usuarioMencionadoId, notificacionId, leida=false, resuelta=false)

        NotifObs --> Eventos : alertaGenerada
        deactivate NotifObs
        Eventos --> API : void
        deactivate Eventos

        API --> UI : 201 Created (Incidencia y adjunto registrados)
        deactivate API
        UI --> UO : Actualiza hilo y confirma notificación al compañero
        deactivate UI
    end
@enduml