@startuml E/R
  top to bottom direction
  skinparam linetype ortho
  skinparam nodesep 100
  skinparam ranksep 80
  hide circle
  skinparam class {
      BackgroundColor LightGray
      ArrowColor Black
      BorderColor Black
      HeaderBackgroundColor Grey
  }

  title Modelo Físico ER Turbine

  ' ==========================================
  ' MÓDULO: IDENTIDAD Y CONFIGURACIÓN
  ' ==========================================
  entity "USUARIO" {
    * id : UUID <<PK>>
    --
    * email : VARCHAR(255) <<UK>>
    * password : VARCHAR(255)
    * rol : VARCHAR(50)
    * activo : BOOLEAN
    * creadoEn : TIMESTAMP
  }

  entity "CONFIGURACION" {
    * clave : VARCHAR(100) <<PK>>
    --
    * usuarioId : UUID <<FK>>
    * valor : TEXT
    * fechaActualizacion : TIMESTAMP
  }

  entity "SERIE_FACTURACION" {
    * codigo : VARCHAR(50) <<PK>>
    --
    * descripcion : VARCHAR(255)
    * ultimoNumero : INTEGER
    * activa : BOOLEAN
  }

  entity "TARIFA_RANGO" {
    * id : UUID <<PK>>
    --
    * nombre : VARCHAR(100)
    * facturacionDesde : DECIMAL(14,2)
    facturacionHasta : DECIMAL(14,2)
    * precioMensual : DECIMAL(12,2)
    * vigenteDesde : DATE
    vigenteHasta : DATE
  }

  ' ==========================================
  ' MÓDULO: CLIENTES Y ETIQUETAS
  ' ==========================================
  entity "CLIENTE" {
    * id : UUID <<PK>>
    --
    * nif : VARCHAR(50) <<UK>>
    * nombreComercial : VARCHAR(255)
    * razonSocial : VARCHAR(255)
    * domicilioFiscal : VARCHAR(500)
    * pais : VARCHAR(100)
    * moneda : VARCHAR(10)
    * impuestoRate : DECIMAL(5,2)
    * estado : VARCHAR(30)
    fechaBajaEfectiva : DATE
    * responsablePrincipalId : UUID <<FK>>
    responsableSuplenteId: UUID <<FK>>
    * version : INTEGER
    * creadoEn: TIMESTAMP
  }

  entity "CONTACTO" {
    * id : UUID <<PK>>
    --
    * nombre : VARCHAR(255)
    * email : VARCHAR(255)
    telefono : VARCHAR(50)
    * idioma : VARCHAR(5)
    * admiteWhatsApp : BOOLEAN
    * activo : BOOLEAN
    * creadoEn : TIMESTAMP
  }

  ' Tabla intermedia para la relación N:M con rol y prioridad
  entity "CLIENTE_CONTACTO" {
    * clienteId : UUID <<PK, FK>>
    * contactoId : UUID <<PK, FK>>
    * rol : VARCHAR(30) <<PK>>
    --
    * prioridad : INTEGER
  }

  entity "ETIQUETA" {
    * id : UUID <<PK>>
    --
    * nombre : VARCHAR(100) <<UK>>
  }

  ' Tabla intermedia para la relación N:M
  entity "CLIENTE_ETIQUETA" {
    * clienteId : UUID <<PK, FK>>
    * etiquetaId : UUID <<PK, FK>>
    --
  }

  entity "SUSCRIPCION" {
    * id : UUID <<PK>>
    --
    * clienteId : UUID <<FK>>
    * tarifaRangoId : UUID <<FK>>
    * precioBase : DECIMAL(12,2)
    * pausada : BOOLEAN
    motivoPausa : VARCHAR(255)
    fechaInicioPausa : TIMESTAMP
    fechaFinPausa: TIMESTAMP
    * version : INTEGER
    * creadoEn: TIMESTAMP
  }

  ' ==========================================
  ' MÓDULO: FACTURACIÓN Y COBROS
  ' ==========================================
  entity "FACTURA" {
    * id : UUID <<PK>>
    --
    * clienteId : UUID <<FK>>
    suscripcionId : UUID <<FK>>
    facturaOriginalId : UUID <<FK>>
    serie : VARCHAR(50) <<FK>>
    numero : VARCHAR(100)
    * tipo : VARCHAR(50)
    * estadoDocumento : VARCHAR(30)
    * incobrable : BOOLEAN
    periodoFacturacion : DATE
    fechaEmision : DATE
    * fechaVencimiento : DATE
    * moneda : VARCHAR(10)
    * baseImponible : DECIMAL(12,2)
    * impuestoTotal : DECIMAL(12,2)
    * total : DECIMAL(12,2)
    * trimestreCerrado : BOOLEAN
    * version : INTEGER
  }

  note right of FACTURA
    UK compuesta (serie, numero)
    UK compuesta (suscripcionId, periodoFacturacion)
  end note

  entity "LINEA_FACTURA" {
    * numeroLinea : INTEGER <<PK>>
    * facturaId : UUID <<PK, FK>>
    --
    * concepto : VARCHAR(255)
    * cantidad : INTEGER
    * precioUnitario : DECIMAL(12,2)
    descuento : DECIMAL(12,2)
    * impuestoRate : DECIMAL(5,2)
  }

  entity "COBRO" {
    * id : UUID <<PK>>
    --
    facturaId : UUID <<FK>>
    * fuente : VARCHAR(30)
    * eventoExternoId : VARCHAR(255)
    ' El identificador que nos proporcione la pasarela de pago, si es que lo aporta
    referenciaExterna : VARCHAR(255)
    * fechaPago : TIMESTAMP
    * importe : DECIMAL(12,2)
    * moneda : VARCHAR(10)
    concepto : VARCHAR(255)
    * estadoConciliacion : VARCHAR(30)
    conciliadoPorId : UUID <<FK>>
    fechaConciliacion : TIMESTAMP
    motivoReversion : TEXT
  }

  note right of COBRO : UK compuesta (fuente, eventoExternoId)

  ' ==========================================
  ' MÓDULO: GOBIERNO, AUDITORÍA Y ALERTAS
  ' ==========================================
  entity "SOLICITUD_APROBACION" {
    * id : UUID <<PK>>
    --
    * tipo : VARCHAR(50)
    * estado : VARCHAR(50)
    * solicitanteId : UUID <<FK>>
    aprobadorId : UUID <<FK>>
    * datosCambio : JSON
    * fechaSolicitud : TIMESTAMP
    fechaResolucion : TIMESTAMP
  }

  entity "AUDITORIA_LOG" {
    * id : UUID <<PK>>
    --
    * usuarioId : UUID <<FK>>
    * entidadAfectada : VARCHAR(100)
    * entidadId : UUID
    * accion : VARCHAR(50)
    valoresAnteriores : JSON
    valoresNuevos : JSON
    * fecha : TIMESTAMP
  }

  entity "PLANTILLA_COMUNICACION" {
    * id : UUID <<PK>>
    --
    * ultimoAutorId : UUID <<FK>>
    * tipo : VARCHAR(50)
    * canal : VARCHAR(50)
    * asunto : VARCHAR(255)
    * cuerpo : TEXT
    * version : INTEGER
    * activa : boolean
  }

  entity "RECIBE_NOTIFICACION"{
    * notificacionId: UUID <<PK, FK>>
    * usuarioId: UUID <<PK,FK>>
    --
    * fechaEnvio: TIMESTAMP
    * leida: BOOLEAN
    resuelta: BOOLEAN
  }

  entity "NOTIFICACION" {
    * id : UUID <<PK>>
    --
    * titulo : VARCHAR(255)
    * mensaje : TEXT
    * requiereAccion : BOOLEAN
  }

  entity "ENVIO" {
    * id : UUID <<PK>>
    --
    * facturaId : UUID <<FK>>
    envioOriginalId : UUID <<FK>>
    contactoId : UUID <<FK>>
    * destinatario : VARCHAR(255)
    * canal : VARCHAR(30)
    * estado : VARCHAR(30)
    * plantillaId : UUID <<FK>>
    * fecha : TIMESTAMP
    detalleError : TEXT
  }

  entity "EJECUCION_PROCESO" {
    * id : UUID <<PK>>
    --
    * clave : VARCHAR(150) <<UK>>
    * tipo : VARCHAR(40)
    * inicio : TIMESTAMP
    fin : TIMESTAMP
    * estado : VARCHAR(30)
    * procesados : INTEGER
    * creados : INTEGER
    * fallidos : INTEGER
    detalleErrores : JSON
  }

  ' ==========================================
  ' MÓDULO: SOPORTE, TICKETS Y ADJUNTOS
  ' ==========================================
  entity "INCIDENCIA" {
    * id : UUID <<PK>>
    --
    * clienteId : UUID <<FK>>
    facturaId : UUID <<FK>>
    * titulo : VARCHAR(255)
    * descripcion : TEXT
    * estado : VARCHAR(50)
    * creadaPorId : UUID <<FK>>
    * fechaCreacion : TIMESTAMP
    fechaResolucion : TIMESTAMP
  }

  entity "COMENTARIO" {
    * id : UUID <<PK>>
    --
    incidenciaId : UUID <<FK>>
    facturaId : UUID <<FK>>
    * usuarioId : UUID <<FK>>
    * texto : TEXT
    * restringidoAdmin : BOOLEAN
    * fechaCreacion : TIMESTAMP
  }

  entity "ADJUNTO" {
    * id : UUID <<PK>>
    --
    clienteId : UUID <<FK>>
    facturaId : UUID <<FK>>
    * nombreArchivo : VARCHAR(255)
    * rutaStorage : VARCHAR(500)
    * tipoMime : VARCHAR(100)
    * tamanoBytes : BIGINT
    * subidoPorId : UUID <<FK>>
    * fechaSubida : TIMESTAMP
  }

  ' ==========================================
  ' RELACIONES
  ' ==========================================

  ' Usuarios (Asignaciones y Auditoría)
  USUARIO |o--o{ CLIENTE : responsableSuplente
  USUARIO ||--o{ CLIENTE : responsablePrincipal
  USUARIO ||--o{ CONFIGURACION
  USUARIO ||--o{ AUDITORIA_LOG
  USUARIO ||--o{ PLANTILLA_COMUNICACION
  USUARIO ||--o{ RECIBE_NOTIFICACION
  NOTIFICACION ||--o{ RECIBE_NOTIFICACION

  ' Aprobaciones
  USUARIO ||--o{ SOLICITUD_APROBACION : solicita
  USUARIO |o--o{ SOLICITUD_APROBACION : aprueba

  ' Clientes, Contactos, Etiquetas y Suscripciones
  CLIENTE ||--o{ CLIENTE_CONTACTO
  CONTACTO ||--o{ CLIENTE_CONTACTO
  CLIENTE ||--o{ CLIENTE_ETIQUETA
  ETIQUETA ||--o{ CLIENTE_ETIQUETA
  CLIENTE ||--o{ SUSCRIPCION
  TARIFA_RANGO ||--o{ SUSCRIPCION

  ' Facturación
  CLIENTE ||--o{ FACTURA
  SUSCRIPCION |o--o{ FACTURA
  SERIE_FACTURACION |o--o{ FACTURA
  FACTURA |o--o{ FACTURA : rectifica
  FACTURA ||--|{ LINEA_FACTURA
  FACTURA |o--o{ COBRO
  USUARIO |o--o{ COBRO : concilia

  ' Envíos de facturas
  FACTURA ||--o{ ENVIO
  ENVIO |o--o{ ENVIO : reintento
  CONTACTO |o--o{ ENVIO
  PLANTILLA_COMUNICACION ||--o{ ENVIO

  ' Soporte y Comunicación
  CLIENTE ||--o{ INCIDENCIA
  USUARIO ||--o{ INCIDENCIA : creadaPor
  FACTURA |o--o{ INCIDENCIA
  INCIDENCIA |o--o{ COMENTARIO
  FACTURA |o--o{ COMENTARIO
  USUARIO ||--o{ COMENTARIO

  ' Adjuntos
  CLIENTE |o--o{ ADJUNTO
  FACTURA |o--o{ ADJUNTO
  USUARIO ||--o{ ADJUNTO

@enduml
