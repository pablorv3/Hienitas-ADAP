@startuml DS03_Conciliacion_Cobros_Stripe
    autonumber
    skinparam sequenceMessageAlign center
    skinparam responseMessageBelowArrow true

    title DS-03: Conciliación de Cobros Externos con Stripe (UC-17)

    participant "cron : PlanificadorCron" as Cron
    participant "worker : WorkerConciliacion" as Worker
    participant "facade : FacturacionFacade" as Facade
    participant "stripe : StripeSimuladoAdapter" as Stripe
    participant "db : BaseDatosRelacional" as DB
    participant "cobro : Cobro" as Cobro
    participant "factura : Factura" as Fac
    participant "eventos : GestorEventosDominio" as Eventos

    Cron -> Worker : Disparar sincronización periódica de cobros
    activate Worker

    Worker -> Facade : conciliarCobrosConfirmados(ultimaSincronizacion)
    activate Facade

    Facade -> Stripe : obtenerCobrosConfirmados(desde)
    activate Stripe
    Stripe --> Facade : cobrosConfirmados : List<Cobro>
    deactivate Stripe

    loop Para cada movimiento en cobrosConfirmados
        Facade -> DB : existeCobro(fuente, movimiento.eventoExternoId)
        activate DB
        DB --> Facade : yaRegistrado : Boolean
        deactivate DB

        alt Evento ya registrado (FR-067.1)
            Facade -> Facade : omitirMovimiento(movimiento)
        else Evento nuevo
        Facade -> Stripe : consultarEstadoPago(movimiento.referenciaExterna)
        activate Stripe
        Stripe --> Facade : estadoExterno ("PAID")
        deactivate Stripe

        Facade -> DB : buscarFacturaPorReferencia(movimiento.referenciaExterna)
        activate DB
        DB --> Facade : factura : Factura
        deactivate DB

        create Cobro
        Facade -> Cobro : <<create>>(fuente, eventoExternoId, referenciaExterna, fechaPago, importe, moneda)

        alt Factura no identificada o dudosa (FR-067.2)
            Facade -> DB : guardarCobro(cobro, facturaId = null, estadoConciliacion = "PENDIENTE")
            activate DB
            DB --> Facade : ok
            deactivate DB

            Facade -> Eventos : publicarEvento("COBRO_NO_IDENTIFICADO", payload)
            activate Eventos
            Eventos --> Facade : void
            deactivate Eventos
        else Factura localizada
            Facade -> Fac : saldoPendiente()
            activate Fac
            Fac --> Facade : saldo : Decimal
            deactivate Fac

            alt Importe exacto (movimiento.importe == saldo)
                Facade -> Fac : registrarCobro(cobro)
                activate Fac
                Fac -> Fac : estadoCobro() = PAGADA (derivado; el documento sigue en EstadoEmitida)
                Fac --> Facade : ok
                deactivate Fac

                Facade -> DB : guardarCobro(cobro, factura.id, estadoConciliacion = "AUTOMATICA")
                activate DB
                DB --> Facade : ok
                deactivate DB

                Facade -> Eventos : publicarEvento("COBRO_CONCILIADO", payload)
                activate Eventos
                Eventos --> Facade : void
                deactivate Eventos
            else Discrepancia de importe (pago parcial o sobrepago - RB-10)
                Facade -> DB : guardarCobro(cobro, factura.id, estadoConciliacion = "PENDIENTE")
                activate DB
                DB --> Facade : ok
                deactivate DB

                Facade -> Eventos : publicarEvento("DISCREPANCIA_IMPORTE_COBRO", payload)
                activate Eventos
                note right of Eventos: NotificacionObserver genera alerta\ncon requiereAccion = true (FR-068).\nLa factura no pasa a pagada.
                Eventos --> Facade : void
                deactivate Eventos
            end
        end
        end
    end

    Facade --> Worker : Resumen conciliación completada
    deactivate Facade

    Worker --> Cron : Tarea finalizada
    deactivate Worker
@enduml